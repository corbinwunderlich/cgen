{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "type": "object",
  "properties": {
    "inputs": {
      "$ref": "#/$defs/InputsConfig"
    },
    "outputs": {
      "$ref": "#/$defs/OutputsConfig"
    }
  },
  "$defs": {
    "CHeaderConfig": {
      "type": "object",
      "properties": {
        "extension": {
          "description": "The output extension for the header files",
          "type": "string",
          "default": "h",
          "examples": [
            "hpp",
            "h"
          ]
        }
      }
    },
    "ClangConfig": {
      "type": "object",
      "properties": {
        "extensions": {
          "description": "The extensions which are parsed by Clang",
          "type": "array",
          "default": [
            "c",
            "cpp",
            "cc",
            "cxx",
            "c++",
            "m",
            "mm"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "InputsConfig": {
      "type": "object",
      "properties": {
        "clang": {
          "$ref": "#/$defs/ClangConfig"
        }
      }
    },
    "OutputKind": {
      "type": "string",
      "enum": [
        "c_header"
      ]
    },
    "OutputsConfig": {
      "type": "object",
      "properties": {
        "c_header": {
          "$ref": "#/$defs/CHeaderConfig"
        },
        "enable": {
          "description": "The outputs to enable",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputKind"
          }
        }
      }
    }
  }
}