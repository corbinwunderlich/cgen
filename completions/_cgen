#compdef cgen

autoload -U is-at-least

_cgen() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-c+[Path to config file]:CONFIG:_files' \
'--config=[Path to config file]:CONFIG:_files' \
'--watch-interval=[Polling interval for --watch, in milliseconds]:WATCH_INTERVAL:_default' \
'-w[Watch for changes in files/directories]' \
'--watch[Watch for changes in files/directories]' \
'-I[Respect .gitignore and .ignore when transforming directories (on by default)]' \
'--ignore[Respect .gitignore and .ignore when transforming directories (on by default)]' \
'-H[Allow transforming hidden files and directories (off by default)]' \
'--hidden[Allow transforming hidden files and directories (off by default)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::path -- Files or directories to transform:_files' \
&& ret=0
}

(( $+functions[_cgen_commands] )) ||
_cgen_commands() {
    local commands; commands=()
    _describe -t commands 'cgen commands' commands "$@"
}

if [ "$funcstack[1]" = "_cgen" ]; then
    _cgen "$@"
else
    compdef _cgen cgen
fi
